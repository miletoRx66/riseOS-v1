# =============================================================================
# RiseOS — Template de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais.
# =============================================================================

# Supabase (obter em: supabase.com → projeto → Settings → API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<sua-chave>

# Conexão direta PostgreSQL (uso local apenas: CLI, migrations)
DATABASE_URL=postgresql://postgres:<sua-senha>@db.<project-ref>.supabase.co:5432/postgres
